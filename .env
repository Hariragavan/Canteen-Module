# ==============================================================================
# SMART CANTEEN OS - ENVIRONMENT CONFIGURATION (MONGODB)
# ==============================================================================

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas Cloud Cluster)
# Example local: mongodb://127.0.0.1:27017/canteen_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/canteen_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/canteen_db

PORT=5000
